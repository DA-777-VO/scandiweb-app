# Ensure shell scripts always use LF line endings (critical for Docker on Linux)
*.sh text eol=lf

# SQL files — LF
*.sql text eol=lf

# PHP files — LF
*.php text eol=lf

# JSON / YAML — LF
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only files (if any) — CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
